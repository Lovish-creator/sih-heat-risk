# SIH26083 Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application Settings
APP_NAME=SIH26083-Heat-Risk-Early-Warning
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Pilot City Selection (ahmedabad, delhi, nagpur, hyderabad)
DEFAULT_CITY=ahmedabad

# Demo Mode Configuration (true: uses deterministic cached/synthetic test fixtures, false: hits live APIs)
DEMO_MODE=true

# Cache Configuration (TTL in seconds - 3600s = 1 hour)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_DIR=data/cache

# NASA POWER API Configuration
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_TIMEOUT_SECONDS=15
NASA_POWER_MAX_RETRIES=3

# External Data Directory Paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SAMPLE_DATA_DIR=data/sample
