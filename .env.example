# ==============================================================================
# SIH 2026 PS26083 ? ThermoShield India Environment Configuration Template
# ==============================================================================

# Application Environment Mode:
# Options: development | demo | testing | production
# In 'demo' or 'development': sample data and fallback profiles are permitted.
# In 'production': ENABLE_FALLBACK_DATA is strictly disabled to prevent silent fallback.
APP_ENV=development

# Data Mode:
# Options: live (Strictly live external APIs) | demo (Synthetic simulation) | hybrid (Live with cache)
DATA_MODE=hybrid

# Fallback Policy:
# true: allows national baseline Census PCA fallback when local ward data is missing (DEMO ONLY)
# false: raises explicit DATA_UNAVAILABLE errors when genuine data is missing (MANDATORY IN PROD)
ENABLE_FALLBACK_DATA=true

# External Ingestion:
ENABLE_EXTERNAL_INGESTION=true
INGESTION_INTERVAL_MINUTES=60

# Database Persistence:
# SQLite (zero configuration for local testing):
DATABASE_URL=sqlite:///./data/heat_risk.db
# PostgreSQL / PostGIS (for Docker & Production deployment):
# DATABASE_URL=postgresql://heatrisk:heatrisk_secret@localhost:5432/heat_risk_db
DB_ECHO=false

# Application Logging:
LOG_LEVEL=INFO
DEBUG=false

# Security & CORS:
SECRET_KEY=sih26083-change-this-secret-key-in-production-deployments
CORS_ORIGINS=["*"]

# External API Providers:
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/hourly/point
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SIH26083-ThermoShield-India/2.0 (moes-ncmrwf-prototype)
